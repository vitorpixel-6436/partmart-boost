"""
PartMart Boost  Steam-inspired dark theme (QSS)
"""

QWIDGET_BASE = """/* GLOBAL */
QWidget {
    background-color: #1B2838;
    color: #FFFFFF;
    font-family: "Segoe UI", sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #1B2838;
}

/* SCROLLBARS */
QScrollBar:vertical {
    background: #1B2838;
    width: 12px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background: #2A475E;
    border-radius: 6px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #66C0F4;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* BUTTONS */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #E63946, stop:1 #C11F28);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #FF4555, stop:1 #D62828);
}
QPushButton:pressed {
    background: #C11F28;
    padding-top: 14px;
}
QPushButton:disabled {
    background: #2A475E;
    color: #8B8B8B;
}
QPushButton.secondary {
    background: #2A475E;
    color: #FFFFFF;
}
QPushButton.secondary:hover {
    background: #66C0F4;
}

/* CARDS */
QFrame.card {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #2A475E, stop:1 #1B2838);
    border: 1px solid #2A475E;
    border-radius: 8px;
    padding: 16px;
}
QFrame.card:hover {
    border: 1px solid #66C0F4;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #2F5368, stop:1 #1F2F3D);
}

/* PROGRESS BAR */
QProgressBar {
    background-color: #1B2838;
    border: 2px solid #2A475E;
    border-radius: 6px;
    text-align: center;
    color: white;
    font-weight: bold;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #66C0F4, stop:0.5 #5DA130, stop:1 #66C0F4);
    border-radius: 4px;
}

/* LABELS */
QLabel.title {
    font-size: 28px;
    font-weight: 700;
    color: #FFFFFF;
}
QLabel.subtitle {
    font-size: 20px;
    font-weight: 500;
    color: #B8B6B4;
}
QLabel.body {
    font-size: 14px;
    color: #B8B6B4;
}
QLabel.muted {
    font-size: 12px;
    color: #8B8B8B;
}

/* TOOLTIP */
QToolTip {
    background-color: #2A475E;
    color: white;
    border: 1px solid #66C0F4;
    border-radius: 4px;
    padding: 8px;
    font-size: 12px;
}

/* TABS */
QTabWidget::pane {
    border: 1px solid #2A475E;
    border-radius: 8px;
    background: #1B2838;
}
QTabBar::tab {
    background: #2A475E;
    color: #B8B6B4;
    padding: 12px 24px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #E63946, stop:1 #C11F28);
    color: white;
}
QTabBar::tab:hover {
    background: #66C0F4;
    color: white;
}

/* LIST WIDGET */
QListWidget {
    background: #1B2838;
    border: 1px solid #2A475E;
    border-radius: 8px;
    padding: 8px;
}
QListWidget::item {
    background: #2A475E;
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 4px;
}
QListWidget::item:hover {
    background: #66C0F4;
}
QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #E63946, stop:1 #C11F28);
}
"""
